rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isInArray(fieldName, uid) {
      return fieldName in resource.data && uid in resource.data[fieldName];
    }

    function isHatimMember() {
      return isAuthenticated()
        && (
          resource.data.createdBy == request.auth.uid
          || isInArray('participants', request.auth.uid)
          || isInArray('readers', request.auth.uid)
        );
    }

    function isFamilyMember() {
      return isAuthenticated()
        && ('members' in resource.data)
        && (request.auth.uid in resource.data.members);
    }

    function isGroupMember() {
      return isAuthenticated()
        && (
          resource.data.createdBy == request.auth.uid
          || (('memberIds' in resource.data) && (request.auth.uid in resource.data.memberIds))
        );
    }

    function hasNoUserServerManagedFieldsOnCreate() {
      return !request.resource.data.keys().hasAny([
        'earnedBadges',
        'familyId',
        'fcmTokens',
        'level',
        'points',
        'role',
        'socialPreferences',
        'stats',
        'streaks',
        'xp'
      ]);
    }

    function userServerManagedFieldsAreUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'earnedBadges',
        'familyId',
        'fcmTokens',
        'level',
        'points',
        'role',
        'socialPreferences',
        'stats',
        'streaks',
        'xp'
      ]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && hasNoUserServerManagedFieldsOnCreate();
      allow update: if isOwner(userId) && userServerManagedFieldsAreUnchanged();
      allow delete: if false;

      match /subscription/status {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /duaAmins/{duaId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /data/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /growth_logs/{logId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /aiProfile/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /assistantSessions/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /weeklyInsights/{weekKey} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /families/{familyId} {
      allow read: if isFamilyMember();
      allow create, update, delete: if false;
    }

    match /familyGroups/{groupId} {
      allow read: if isGroupMember();
      allow create, delete: if false;
      allow update: if false;
    }

    match /hatims/{hatimId} {
      allow read: if isHatimMember();
      allow create, update, delete: if false;
    }

    match /duas/{duaId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /referrals/{referralId} {
      allow read: if isAuthenticated() && resource.data.inviterId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /config/aiFlags {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /config/onboardingExperience {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /config/premiumMoments {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /ops/aiReleaseStatus {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /public/{document=**} {
      allow read, write: if false;
    }
  }
}
