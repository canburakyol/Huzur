{
  "name": "huzur-app",
  "private": true,
  "version": "18.2.10",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run theme:check && vite build",
    "theme:sync": "node ./scripts/sync-theme-tokens.mjs",
    "theme:check": "node ./scripts/sync-theme-tokens.mjs --check",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:backend",
    "test:unit": "vitest run --config vitest.config.js",
    "test:unit:watch": "vitest --config vitest.config.js",
    "test:backend": "node ./scripts/ensure-functions-deps.cjs && firebase emulators:exec --only firestore \"npm run test:backend:raw\"",
    "test:backend:raw": "vitest run --config vitest.backend.config.js",
    "test:e2e": "playwright test --config playwright.config.js",
    "preview": "vite preview",
    "audit:i18n": "node ./scripts/i18n-audit.mjs",
    "audit:android-strings": "node ./scripts/android-strings-audit.mjs",
    "audit:localization": "npm run audit:i18n && npm run audit:android-strings",
    "sync:translation-keys": "node ./scripts/sync-translation-keys.mjs",
    "bundle:budget": "node ./scripts/checkBundleBudget.mjs",
    "build:ci": "npm run build && npm run bundle:budget",
    "codex:guard": "node ./scripts/codex-huzur-guard.mjs",
    "scope:files": "node ./scripts/scope-files.js",
    "scope:info": "node ./scripts/scope-files.js info",
    "scope:resolve": "node ./scripts/scope-files.js resolve",
    "scope:task": "node ./scripts/scope-files.js task",
    "scope:doctor": "node ./scripts/scope-files.js doctor"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor-firebase/app-check": "^8.0.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.1",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/screen-orientation": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capawesome/capacitor-app-update": "^8.0.0",
    "@fontsource/noto-naskh-arabic": "^5.2.11",
    "@fontsource/scheherazade-new": "^5.2.8",
    "@revenuecat/purchases-capacitor": "^12.0.0",
    "adhan": "^4.4.3",
    "axios": "^1.18.1",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "firebase": "^12.6.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "leaflet": "^1.9.4",
    "localforage": "^1.10.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^14.27.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1",
    "openai": "^6.27.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "@protobufjs/utf8": "^1.1.1",
    "@grpc/grpc-js": "^1.14.4",
    "form-data": "^4.0.6",
    "protobufjs": "^8.6.5",
    "qs": "^6.15.3",
    "tar": "^7.5.7",
    "serialize-javascript": "^7.0.5"
  }
}
