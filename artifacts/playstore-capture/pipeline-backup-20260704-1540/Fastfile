default_platform(:android)

SCREENSHOT_DIR = File.expand_path(
  "metadata/android/tr-TR/images/phoneScreenshots",
  __dir__
)

platform :android do
  desc "Frame Turkish Google Play phone screenshots with Frameit"
  lane :frame_screenshots do
    expected_screenshots = %w[
      01_home.png
      02_prayer_times.png
      03_quran.png
      04_qibla.png
      05_dhikr.png
      06_dua.png
    ]

    missing = expected_screenshots.reject do |filename|
      File.file?(File.join(SCREENSHOT_DIR, filename))
    end

    UI.user_error!("Missing source screenshots: #{missing.join(', ')}") unless missing.empty?

    frameit(
      path: SCREENSHOT_DIR,
      white: false
    )
  end
end
