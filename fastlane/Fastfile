default_platform(:android)
skip_docs

SCREENSHOT_DIR = File.expand_path(
  "metadata/android/tr-TR/images/phoneScreenshots",
  __dir__
)

platform :android do
  desc "Frame Turkish Google Play phone screenshots with Frameit"
  lane :frame_screenshots do
    expected_screenshots = %w[
      01_home.png
      02_prayer_times.png
      03_quran.png
      04_qibla.png
      05_dhikr.png
      06_dua.png
      07_premium.png
    ]

    missing = expected_screenshots.reject do |filename|
      File.file?(File.join(SCREENSHOT_DIR, filename))
    end

    UI.user_error!("Missing source screenshots: #{missing.join(', ')}") unless missing.empty?

    UI.message("Framing only: #{SCREENSHOT_DIR}")
    frameit(
      path: SCREENSHOT_DIR,
      white: false
    )
  end

  desc "Upload metadata + screenshots only (no binary)"
  lane :upload_metadata do
    supply(
      package_name: "com.huzurapp.android",
      metadata_path: File.expand_path("metadata/android", __dir__),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Upload AAB to internal track with metadata"
  lane :internal do
    supply(
      package_name: "com.huzurapp.android",
      track: "internal",
      aab: ENV["HUZUR_AAB_PATH"] || Dir["../android/app/build/outputs/bundle/release/*.aab"].first,
      metadata_path: File.expand_path("metadata/android", __dir__),
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Promote internal → production (staged rollout 20%)"
  lane :promote_production do
    supply(
      package_name: "com.huzurapp.android",
      track: "internal",
      track_promote_to: "production",
      rollout: "0.2",
      skip_upload_metadata: true
    )
  end
end
